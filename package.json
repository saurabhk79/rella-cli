{
  "name": "rella",
  "version": "0.1.0",
  "description": "RELLa – CLI-based AI assistant for dev workflows",
  "bin": {
    "rella": "dist/cli/index.js"
  },
  "main": "dist/cli/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -w",
    "dev": "ts-node src/cli/index.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier \"src/**/*.{ts,tsx,js,md}\" --write",
    "format:check": "prettier \"src/**/*.{ts,tsx,js,md}\" --check",
    "test": "echo \"No tests yet\"",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "cli",
    "ai",
    "devtools",
    "assistant",
    "openrouter",
    "gemini",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "commander": "^12.0.0",
    "execa": "^9.0.0",
    "inquirer": "^9.0.0",
    "minimatch": "^9.0.0"
  },
  "devDependencies": {
    "@types/commander": "^2.12.5",
    "@types/inquirer": "^9.0.3",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
